{
  "$schema": "https://app.clawnify.com/schema/v1/clawnify.json",
  "version": 1,
  "name": "OpenCMS",
  "description": "An open headless CMS — edit content in a table, serve it over a JSON API.",
  "icon": "icon.svg",
  "app": {
    "framework": "react+hono",
    "database": true,
    "storage": true
  },
  "env": {
    "required": ["OPENROUTER_API_KEY"]
  },
  "api": {
    "public_routes": [
      { "path": "/api/entries/**", "methods": ["GET"] },
      { "path": "/api/uploads/*", "methods": ["GET"] },
      "/api/openapi.json"
    ]
  }
}
